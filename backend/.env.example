PROJECT_NAME=Aptly
API_V1_STR=/api
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aptly_db

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend URL
FRONTEND_URL=http://localhost:5173

# LLM Service (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Aptly Voice Assistant & ElevenLabs TTS
ASSISTANT_SPEECH_LIMIT=5
ASSISTANT_SPEECH_WINDOW_SECONDS=60
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Job Provider Configuration (adzuna, remotive, or mock)
JOB_PROVIDER=adzuna
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=in
ADZUNA_RESULTS_PER_PAGE=15
ADZUNA_MAX_PAGES_PER_QUERY=1
JOB_PROVIDER_API_KEY=
JOB_PROVIDER_BASE_URL=https://api.adzuna.com/v1/api/jobs
JOB_PROVIDER_LIMIT=50

