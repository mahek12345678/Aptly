# Aptly Application Configuration

# App
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aptly_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aptly_db

# Integrations
REDIS_URL=redis://localhost:6379/0
GOOGLE_CLIENT_ID=
JWT_SECRET_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ASSISTANT_SPEECH_LIMIT=5
ASSISTANT_SPEECH_WINDOW_SECONDS=60
